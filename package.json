{
  "name": "stmarys-accounts",
  "private": true,
  "version": "2.0.0",
  "description": "St. Mary's Voucher System - Express/PostgreSQL API + React web app",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "test": "npm test -w server && npm test -w web",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.19",
    "@rolldown/binding-linux-x64-gnu": "1.2.19",
    "@rolldown/binding-linux-x64-musl": "1.2.19",
    "@rolldown/binding-linux-arm64-musl": "1.2.19",
    "@esbuild/darwin-arm64": "0.28.2",
    "@esbuild/linux-x64": "0.28.2",
    "@esbuild/linux-arm64": "0.28.2",
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-linux-x64-musl": "1.33.0",
    "lightningcss-linux-arm64-musl": "1.33.0"
  }
}
