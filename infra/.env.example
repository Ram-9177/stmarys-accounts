# Copy to infra/.env on the server:  cp .env.example .env && nano .env
# Domain pointing at the EC2 Elastic IP (Caddy gets the HTTPS certificate automatically)
DOMAIN=vouchers.example.edu.in

# Long random password: openssl rand -base64 32
POSTGRES_PASSWORD=

# JWT keys - run locally: npm run keys -w server   (paste both lines)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Nightly backups (bucket must exist; EC2 instance role needs s3:PutObject on it)
BACKUP_S3_URI=s3://stmarys-voucher-backups/postgres
AWS_REGION=ap-south-1

# Optional - Microsoft SSO
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional - email via Amazon SES SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="St. Mary's Vouchers <no-reply@example.edu.in>"

# Optional - UOS platform (open Accounts from the UOS launcher). See docs/UOS_INTEGRATION.md.
UOS_ENABLED=false
UOS_MODULE_ID=
UOS_AUTH_PUBLIC_KEY=
UOS_SHELL_URL=
UOS_CAMPUS_MAP='{"<AP campus id>": ["smgg", "smwec"], "<HYD campus id>": ["smhyd"]}'
UOS_ORG_ID=
UOS_REDIS_URL=
UOS_NEW_USERS=pending
UOS_LEGACY_LOGIN=true
UOS_LINK_EMAILS=
REDIS_KEY_PREFIX=
