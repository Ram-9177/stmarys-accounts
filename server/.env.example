# ---- Server ----
NODE_ENV=development
PORT=4000
# Public URL of the web app (no trailing slash). In production the API is served under the same origin at /api.
APP_ORIGIN=http://localhost:5173
EXTRA_ORIGINS=
# Number of proxy hops in front of the API (ALB/nginx) so client IPs are correct for rate limits & audit logs.
TRUST_PROXY=1
# Serve the built web app from this folder (Docker image sets this). Leave empty in development.
STATIC_DIR=

# ---- PostgreSQL 16 ----
DATABASE_URL=postgres://localhost:5432/stmarys_dev
# Set true for Amazon RDS
DATABASE_SSL=false

# ---- Redis 7 ----
REDIS_URL=redis://localhost:6379/14

# ---- Auth ----
# RS256 keys (base64 PEM). Generate with: npm run keys -w server
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12
# Only used on an EMPTY database: creates admin / admin_stmw / admin_smhyd with this password.
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Microsoft SSO (optional; leave MS_CLIENT_ID empty to disable) ----
# Redirect URI to register in Entra ID: ${APP_ORIGIN}/api/auth/sso/microsoft/callback
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---- Email via SMTP, e.g. Amazon SES (optional; leave SMTP_HOST empty to disable) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="St. Mary's Vouchers <no-reply@example.com>"

# ---- Database layout for a UOS tenant database (optional) ----
# UOS keeps one schema per module in each university's tenant DB. Leave empty to use "public" in your own DB.
DATABASE_SCHEMA=
# Migrations run as this connection when set (UOS: the accounts_admin role). Defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=
# After migrating, grant table/sequence rights on the schema to this role (UOS: accounts_app).
DB_APP_ROLE=
# Prefix for this app's own Redis keys when the Redis is shared with other UOS services, e.g. accounts:
REDIS_KEY_PREFIX=

# ---- UOS platform: open Accounts from the UOS launcher (see docs/UOS_INTEGRATION.md) ----
UOS_ENABLED=false
# Module id registered on the UOS auth server (the module pass audience; sent to /reselect as moduleId)
UOS_MODULE_ID=
# Optional: expected `iss` of module passes
UOS_ISSUER=
# The auth server's PUBLIC key (PEM or base64 PEM), or a path to it. Never the private key.
UOS_AUTH_PUBLIC_KEY=
UOS_AUTH_PUBLIC_KEY_PATH=
# The UOS shell (uos-auth-ui), e.g. https://uos.smru.in  (no trailing slash; may include a path such as /auth)
UOS_SHELL_URL=
UOS_SHELL_LOGOUT_PATH=
# UOS campus id -> colleges. Keep the single quotes around the JSON.
UOS_CAMPUS_MAP='{"<AP campus id>": {"code": "AP", "name": "Andhra Pradesh", "colleges": ["smgg", "smwec"]}, "<HYD campus id>": {"code": "HYD", "name": "Hyderabad", "colleges": ["smhyd"]}}'
# Only accept passes for this university (SMRU's org id)
UOS_ORG_ID=
# People with no matching Accounts user: pending (admin approves) | active | off
UOS_NEW_USERS=pending
UOS_DEFAULT_PERMISSIONS=create_voucher,view_own_vouchers,print_voucher
# Keep password sign-in while staff move over; set false to make UOS the only way in
UOS_LEGACY_LOGIN=true
# Refuse passes after UOS sign-out/deactivation (reads the platform Redis)
UOS_REVOCATION_CHECK=true
# The platform Redis the auth server writes sign-outs to, with its db number (required in production)
UOS_REDIS_URL=
# Give existing users their UOS email at start-up, e.g. admin:principal@smru.in,baji:baji@smru.in
UOS_LINK_EMAILS=
# The university's accent colour in UOS (its accent_color), e.g. #095078. Empty = the UOS default.
UOS_ACCENT_COLOR=
# Local testing only (npm run dev:uos -w server -- keys): signs fake passes, never set in production
# UOS_DEV_PRIVATE_KEY=

# ---- On Account (F2/B4) and the MRF link (see docs/ON_ACCOUNT_MRF.md) ----
# Shared with the MRF module (sent as x-module-credential). Empty = the MRF link is off. At least 24 characters.
MRF_LINK_SECRET=
# second_person: a second person approves every advance before it is paid. off: prepared = paid.
ADVANCE_APPROVAL=second_person
ADVANCE_EMPLOYEE_DAYS=15
ADVANCE_CASH_LIMIT=10000
ADVANCE_UPI_LIMIT=100000
ADVANCE_CARD_LIMIT=200000
# Above this, a main administrator or a Head approves.
ADVANCE_HIGH_LIMIT=200000
